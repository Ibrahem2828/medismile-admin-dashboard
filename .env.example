# MediSmile Admin Dashboard — environment template
#
# Local (Node):
#   cp .env.example .env.local
#   npm install && npm run build && npm run start
#
# Docker Compose:
#   cp .env.example .env
#   docker compose up -d --build
#

# Required — browser + server API base (no trailing slash issues; include /api)
NEXT_PUBLIC_API_BASE_URL=https://api.medismile.xn--mgbaab0cxheq.tech/api

# Optional metadata (also available as Docker build args)
NEXT_PUBLIC_APP_NAME=MediSmile Admin
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# Host port published by docker compose (maps to container :3000)
ADMIN_HOST_PORT=3000

# Local development only (optional):
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
